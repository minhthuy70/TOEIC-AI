generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            Int                             @id @default(autoincrement())
  fullName                      String
  email                         String                          @unique
  isEmailVerified               Boolean                         @default(false)
  verificationCode              String?
  verificationCodeExpiresAt     DateTime?
  password                      String?
  googleId                      String?                         @unique
  facebookId                    String?                         @unique
  avatarUrl                     String?
  createdAt                     DateTime                        @default(now())
  lastLoginAt                   DateTime?
  role                          UserRole                        @default(USER)
  isActive                      Boolean                         @default(true)
  deactivatedAt                 DateTime?
  isLocked                      Boolean                         @default(false)
  lockedUntil                   DateTime?
  isPermanentlyLocked           Boolean                         @default(false)
  unlockRequestSent             Boolean                         @default(false)
  unlockRequestSentAt           DateTime?
  sessions                      UserSession[]
  profile                       UserProfile?
  grammarProgress               UserGrammarProgress[]
  user_listening_group_progress user_listening_group_progress[]
  user_listening_progress       user_listening_progress[]
  user_reading_progress         user_reading_progress[]
  vocabularyProgress            UserVocabularyProgress[]
  practice_sessions             practice_sessions[]
  mock_test_attempts            mock_test_attempts[]
  stageChangeRequests       StageChangeRequest[] @relation("requestedBy")
  reviewedStageRequests     StageChangeRequest[] @relation("reviewedBy")
  goals                     Goal[]
  userAchievements          UserAchievement[]
  studySchedules            StudySchedule[]
  dailyTasks                DailyTask[]
  reminderSetting           StudyReminderSetting?
  pointsTransactions        PointsTransaction[]
  userLevels                UserLevel[]
  userBadges                UserBadge[]
  levelUpNotifications      LevelUpNotification[]
}

model UserSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  deviceInfo String?
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("user_sessions")
}

model UserProfile {
  id                  Int       @id @default(autoincrement())
  currentScore        Int?
  targetScore         Int?
  examDate            DateTime?
  dailyStudyTime      Int?
  firstLoginCompleted Boolean   @default(false)
  userId              Int       @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  avatar              String?
  phone               String?
  birthday            DateTime? @db.Date
  gender              String?
  address             String?
  bio                 String?
  studyNotification   Boolean   @default(true)
  srsNotification     Boolean   @default(true)
  autoPronunciation   Boolean   @default(false)
  darkMode            Boolean   @default(true)
  studySchedule       String?   @db.VarChar(20)
  motivationLevel     Int?      @default(5)
  learningStyle       String?   @db.VarChar(20)
  lastPlacementTestAt DateTime?
  currentStage        Int?      @default(1)
  stageAcceptedAt     DateTime?
  dailyVocabularyGoal Int       @default(20)
  streak              Int       @default(0)
  longestStreak       Int       @default(0)
  streakFreezeCount   Int       @default(2)
  streakProtection    Boolean   @default(false)
  frozenDates         String    @default("")
  pointsBalance       Int       @default(0)
  totalPointsEarned   Int       @default(0) @map("total_points_earned")
  currentStreakMultiplier Float  @default(1.0) @map("current_streak_multiplier")
  xp                  Int       @default(0)
  level               Int       @default(1)
  xpToNextLevel       Int       @default(100) @map("xp_to_next_level")
  totalXpEarned       Int       @default(0) @map("total_xp_earned")
  user                User      @relation(fields: [userId], references: [id])
}

model Vocabulary {
  id                Int                      @id @default(autoincrement())
  english           String                   @db.VarChar(255)
  type              String?                  @db.VarChar(50)
  vietnamese        String?
  pronounce         String?                  @db.VarChar(255)
  explain           String?
  example           String?
  exampleVietnamese String?                  @map("example_vietnamese")
  imageUrl          String?                  @map("image_url")
  audioUrl          String?                  @map("audio_url")
  topic             String?                  @db.VarChar(255)
  topicUrl          String?                  @map("topic_url")
  createdAt         DateTime?                @default(now()) @map("created_at") @db.Timestamp(6)
  stage             Int                      @default(1) @db.SmallInt
  progresses        UserVocabularyProgress[]

  @@map("vocabulary")
}

model UserVocabularyProgress {
  id           Int        @id @default(autoincrement())
  userId       Int        @map("user_id")
  vocabularyId Int        @map("vocabulary_id")
  learnedAt    DateTime?  @map("learned_at") @db.Timestamp(6)
  reviewCount  Int?       @default(0) @map("review_count")
  nextReview   DateTime?  @map("next_review") @db.Timestamp(6)
  createdAt    DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  status       String     @default("NEW") @db.VarChar(20)
  reviewLevel  Int        @default(0) @map("review_level") @db.SmallInt
  lastReview   DateTime?  @map("last_review") @db.Timestamp(6)
  notes        String?    @db.Text
  customExample String?   @map("custom_example") @db.Text
  updatedAt    DateTime?  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, vocabularyId])
  @@map("user_vocabulary_progress")
}

model GrammarCategory {
  id           Int             @id @default(autoincrement())
  name         String          @db.VarChar(100)
  description  String?
  displayOrder Int?            @default(0) @map("display_order")
  createdAt    DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  stage        Int             @default(1)
  lessons      GrammarLesson[]

  @@map("grammar_categories")
}

model GrammarLesson {
  id           Int                   @id @default(autoincrement())
  categoryId   Int                   @map("category_id")
  title        String                @db.VarChar(255)
  content      String?
  displayOrder Int?                  @default(0) @map("display_order")
  createdAt    DateTime?             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  testId       Int?                  @map("test_id")
  category     GrammarCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_grammar_category")
  tests        tests?                @relation(fields: [testId], references: [id], map: "fk_grammar_test")
  progresses   UserGrammarProgress[]

  @@map("grammar_lessons")
}

model UserGrammarProgress {
  id          Int           @id @default(autoincrement())
  userId      Int           @map("user_id")
  lessonId    Int           @map("lesson_id")
  completed   Boolean?      @default(false)
  score       Int?          @default(0)
  lastStudied DateTime?     @map("last_studied") @db.Timestamp(6)
  createdAt   DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  lesson      GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_grammar_lesson")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_grammar_user")

  @@unique([userId, lessonId], map: "uq_user_grammar")
  @@map("user_grammar_progress")
}

model listening_lesson_groups {
  id                            Int                             @id @default(autoincrement())
  lesson_id                     Int
  title                         String?                         @db.VarChar(255)
  audio_url                     String?
  start_seconds                 Decimal?                        @db.Decimal(10, 2)
  end_seconds                   Decimal?                        @db.Decimal(10, 2)
  display_order                 Int?                            @default(0)
  created_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  updated_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  image_url                     String?
  knowledge                     String?
  listening_lessons             listening_lessons               @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_listening_lesson_groups_lesson")
  listening_lesson_questions    listening_lesson_questions[]
  user_listening_group_progress user_listening_group_progress[]

  @@index([lesson_id], map: "idx_listening_lesson_groups_lesson")
}

model listening_lesson_options {
  id                         Int                        @id @default(autoincrement())
  question_id                Int
  option_label               String                     @db.VarChar(1)
  option_text                String
  is_correct                 Boolean?                   @default(false)
  display_order              Int?                       @default(0)
  created_at                 DateTime?                  @default(now()) @db.Timestamp(6)
  listening_lesson_questions listening_lesson_questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_listening_lesson_options_question")

  @@index([question_id], map: "idx_listening_lesson_options_question")
}

model listening_lesson_questions {
  id                       Int                        @id @default(autoincrement())
  group_id                 Int
  question_number          Int
  question_text            String
  explanation              String?
  display_order            Int?                       @default(0)
  created_at               DateTime?                  @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                  @default(now()) @db.Timestamp(6)
  knowledge                String?
  listening_lesson_options listening_lesson_options[]
  listening_lesson_groups  listening_lesson_groups    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_listening_lesson_questions_group")

  @@index([group_id], map: "idx_listening_lesson_questions_group")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model listening_lessons {
  id                      Int                       @id @default(autoincrement())
  title                   String                    @db.VarChar(255)
  part                    Int                       @db.SmallInt
  question_group_id       Int?
  display_order           Int?                      @default(0)
  created_at              DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamp(6)
  stage                   Int                       @default(1) @db.SmallInt
  listening_lesson_groups listening_lesson_groups[]
  question_groups         question_groups?          @relation(fields: [question_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_listening_question_group")
  user_listening_progress user_listening_progress[]
}

model options {
  id            Int        @id @default(autoincrement())
  question_id   Int?
  option_label  String?    @db.Char(1)
  option_text   String?
  is_correct    Boolean?   @default(false)
  display_order Int?
  questions     questions? @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model question_groups {
  id                Int                 @id @default(autoincrement())
  test_id           Int?
  part              Int?
  title             String?
  passage           String?
  image_url         String?
  audio_url         String?
  display_order     Int?
  group_type        String?             @db.VarChar(30)
  audio_start_time  Int?
  audio_end_time    Int?
  knowledge         String?
  listening_lessons listening_lessons[]
  tests             tests?              @relation(fields: [test_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questions         questions[]
}

model questions {
  id              Int              @id @default(autoincrement())
  group_id        Int?
  question_number Int?
  question_text   String?
  correct_answer  String?          @db.Char(1)
  explanation     String?
  display_order   Int?
  options         options[]
  question_groups question_groups? @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model reading_lessons {
  id                    Int                     @id @default(autoincrement())
  title                 String                  @db.VarChar(255)
  part                  Int                     @db.SmallInt
  display_order         Int?                    @default(0)
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  updated_at            DateTime?               @default(now()) @db.Timestamp(6)
  description           String?
  difficulty            Int?                    @default(1) @db.SmallInt
  reading_lesson_groups reading_lesson_groups[]
  user_reading_progress user_reading_progress[]
}

model tests {
  id                Int               @id @default(autoincrement())
  title             String?           @db.VarChar(100)
  duration          Int?
  total_questions   Int?
  created_at        DateTime?         @default(now()) @db.Timestamp(6)
  description       String?
  is_active         Boolean?          @default(true)
  grammar_lessons   GrammarLesson[]
  question_groups   question_groups[]
  mock_test_attempts mock_test_attempts[]
}

model user_listening_progress {
  id                Int               @id @default(autoincrement())
  user_id           Int
  lesson_id         Int
  best_score        Int?              @default(0)
  completed         Boolean?          @default(false)
  last_studied      DateTime?         @db.Timestamp(6)
  created_at        DateTime?         @default(now()) @db.Timestamp(6)
  updated_at        DateTime?         @default(now()) @db.Timestamp(6)
  listening_lessons listening_lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_listening_lesson")
  User              User              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_listening_user")

  @@unique([user_id, lesson_id], map: "uq_user_listening")
}

model user_listening_group_progress {
  id         Int                     @id @default(autoincrement())
  user_id    Int
  group_id   Int
  completed  Boolean?                @default(false)
  score      Int?                    @default(0)
  learned_at DateTime?               @db.Timestamp(6)
  created_at DateTime?               @default(now()) @db.Timestamp(6)
  updated_at DateTime?               @default(now()) @db.Timestamp(6)
  group      listening_lesson_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_listening_group")
  user       User                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_listening_group_user")

  @@unique([user_id, group_id], map: "uq_user_listening_group")
}

model user_reading_progress {
  id           Int       @id @default(autoincrement())
  user_id      Int
  lesson_id    Int
  best_score   Int?      @default(0)
  completed    Boolean?  @default(false)
  last_studied DateTime? @db.Timestamp(6)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  group_id     Int

  lesson reading_lessons       @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_reading_lesson")
  user   User                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_reading_user")
  group  reading_lesson_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_reading_group")

  @@unique([user_id, lesson_id], map: "uq_user_reading")
  @@unique([user_id, group_id])
}

model reading_lesson_groups {
  id            Int       @id @default(autoincrement())
  lesson_id     Int
  part          Int       @db.SmallInt
  group_number  Int
  title         String?   @db.VarChar(255)
  passage       String?
  knowledge     String?
  display_order Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  reading_lessons       reading_lessons         @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reading_lesson_groups_lesson")
  reading_questions     reading_questions[]
  user_reading_progress user_reading_progress[]

  @@index([lesson_id], map: "idx_reading_lesson_groups_lesson")
  @@index([display_order], map: "idx_reading_lesson_groups_order")
  @@index([part], map: "idx_reading_lesson_groups_part")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reading_options {
  id                Int               @id @default(autoincrement())
  question_id       Int
  option_key        String            @db.VarChar(1)
  option_text       String
  is_correct        Boolean?          @default(false)
  display_order     Int?              @default(0)
  created_at        DateTime?         @default(now()) @db.Timestamp(6)
  reading_questions reading_questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reading_options_question")

  @@unique([question_id, option_key], map: "uq_reading_question_option")
}

model reading_questions {
  id                    Int                   @id @default(autoincrement())
  group_id              Int
  question_number       Int
  question_text         String
  question_type         String?               @db.VarChar(50)
  explanation           String?
  knowledge             String?
  correct_answer        String?               @db.VarChar(1)
  display_order         Int?                  @default(0)
  created_at            DateTime?             @default(now()) @db.Timestamp(6)
  updated_at            DateTime?             @default(now()) @db.Timestamp(6)
  reading_options       reading_options[]
  reading_lesson_groups reading_lesson_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reading_questions_group")

  @@index([group_id], map: "idx_reading_questions_group")
  @@index([display_order], map: "idx_reading_questions_order")
}

model practice_sessions {
  id              Int       @id @default(autoincrement())
  user_id         Int       @map("user_id")
  part            Int
  question_count  Int       @map("question_count")
  correct_count   Int       @map("correct_count")
  score           Int
  started_at      DateTime  @map("started_at") @db.Timestamp(6)
  completed_at    DateTime? @map("completed_at") @db.Timestamp(6)
  question_ids    Int[]
  answers         Json?
  created_at      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  
  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@map("practice_sessions")
}

model mock_test_attempts {
  id                Int       @id @default(autoincrement())
  user_id           Int       @map("user_id")
  test_id           Int       @map("test_id")
  listening_score   Int?      @map("listening_score")
  reading_score     Int?      @map("reading_score")
  total_score       Int?      @map("total_score")
  listening_correct Int?      @map("listening_correct")
  reading_correct   Int?      @map("reading_correct")
  total_correct     Int?      @map("total_correct")
  started_at        DateTime  @map("started_at") @db.Timestamp(6)
  submitted_at      DateTime? @map("submitted_at") @db.Timestamp(6)
  answers           Json?
  created_at        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  test              tests     @relation(fields: [test_id], references: [id], onDelete: Cascade)
  
  @@map("mock_test_attempts")
}

enum UserRole {
  USER
  CONTENT_ADMIN
  SUPER_ADMIN
}

model StageChangeRequest {
  id                  Int       @id @default(autoincrement())
  userId              Int
  currentStage        Int
  requestedStage      Int
  reason              String?   @db.Text
  status              String    @default("PENDING") @db.VarChar(20)
  requestedAt         DateTime  @default(now())
  reviewedAt          DateTime?
  reviewedBy          Int?
  adminComment        String?   @db.Text
  user                User      @relation("requestedBy", fields: [userId], references: [id], onDelete: Cascade)
  admin               User?     @relation("reviewedBy", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@map("stage_change_requests")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@map("system_settings")
}

model Goal {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String   @db.VarChar(50) // score, vocabulary, study_time
  targetValue Int      @map("target_value")
  deadline    DateTime? @db.Timestamp(6)
  progress    Int      @default(0)
  status      String   @default("on_track") @db.VarChar(20) // on_track, behind, ahead, completed
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  completedAt DateTime? @map("completed_at") @db.Timestamp(6)
  title       String?  @db.VarChar(255)
  description String?  @db.Text

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("goals")
}

model Achievement {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  category    String   @db.VarChar(50) // learning, practice, streak, accuracy
  criteria    String   @db.Text // JSON string containing criteria
  points      Int      @default(0)
  icon        String?  @db.VarChar(100)
  badgeColor  String?  @db.VarChar(20) @default("amber")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  userAchievements UserAchievement[]

  @@index([category])
  @@index([isActive])
  @@map("achievements")
}

model UserAchievement {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  achievementId  Int      @map("achievement_id")
  unlockedAt     DateTime @default(now()) @map("unlocked_at") @db.Timestamp(6)
  progress       Int      @default(0)
  shareCount     Int      @default(0) @map("share_count")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement    Achievement  @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}

model StudySchedule {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  dayOfWeek   Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime   String   @db.VarChar(5) // Format "HH:MM"
  endTime     String   @db.VarChar(5) // Format "HH:MM"
  title       String   @db.VarChar(255)
  sessionType String   @db.VarChar(50)  // vocabulary, listening, reading, grammar, test
  isRecurring Boolean  @default(true)
  reminder    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("study_schedules")
}

model DailyTask {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  title        String   @db.VarChar(255)
  duration     Int      @default(30) // Số phút học tập dự kiến
  completed    Boolean  @default(false)
  displayOrder Int      @default(0) @map("display_order")
  reminder     Boolean  @default(false)
  notes        String?  @db.Text
  taskDate     DateTime @default(now()) @map("task_date") @db.Date // Lọc nhiệm vụ theo ngày
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, taskDate])
  @@map("daily_tasks")
}

model StudyReminderSetting {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique @map("user_id")
  enabled           Boolean  @default(true)
  reminderTime      String   @default("08:00") @db.VarChar(5) // Định dạng "HH:MM"
  reminderType      String   @default("push") @db.VarChar(20)  // "push", "email", "both"
  customMessage     String   @default("Đã đến giờ học TOEIC rồi, hãy cùng vào học nhé!") @db.VarChar(255)
  frequency         String   @default("daily") @db.VarChar(20) // "daily", "weekly"
  tasksEnabled      Boolean  @default(true)                    // Nhắc nhở nhiệm vụ tự chọn
  reviewsEnabled    Boolean  @default(true)                    // Nhắc nhở ôn tập đến hạn
  testsEnabled      Boolean  @default(true)                    // Nhắc nhở kiểm tra
  streakEnabled     Boolean  @default(true)                    // Nhắc nhở giữ chuỗi
  snoozeMinutes     Int      @default(15)                      // Số phút hoãn mặc định
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_reminder_settings")
}

model Level {
  id          Int      @id @default(autoincrement())
  levelNumber Int      @unique @map("level_number")
  name        String   @db.VarChar(100)
  description String?  @db.Text
  xpRequired  Int      @map("xp_required")
  rewards     String?  @db.Text // JSON string containing rewards (points, badges, etc.)
  icon        String?  @db.VarChar(100)
  color       String?  @db.VarChar(20) @default("blue")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  userLevels  UserLevel[]

  @@index([levelNumber])
  @@index([isActive])
  @@map("levels")
}

model UserLevel {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  levelId     Int      @map("level_id")
  achievedAt  DateTime @default(now()) @map("achieved_at") @db.Timestamp(6)
  xpEarned    Int      @default(0) @map("xp_earned")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId])
  @@index([levelId])
  @@map("user_levels")
}

model Badge {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  category    String   @db.VarChar(50) // achievement, milestone, special, rare, limited
  criteria    String   @db.Text // JSON string containing criteria
  icon        String?  @db.VarChar(100)
  badgeColor  String?  @db.VarChar(20) @default("amber")
  rarity      String   @db.VarChar(20) @default("common") // common, rare, epic, legendary, limited
  isLimited   Boolean  @default(false) @map("is_limited")
  limitCount  Int?     @map("limit_count")
  limitExpiresAt DateTime? @map("limit_expires_at") @db.Timestamp(6)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  userBadges  UserBadge[]

  @@index([category])
  @@index([rarity])
  @@index([isActive])
  @@index([isLimited])
  @@map("badges")
}

model UserBadge {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  badgeId        Int      @map("badge_id")
  unlockedAt     DateTime @default(now()) @map("unlocked_at") @db.Timestamp(6)
  progress       Int      @default(0)
  shareCount     Int      @default(0) @map("share_count")
  isDisplayed    Boolean  @default(false) @map("is_displayed") // Whether to show on profile

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge          Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([isDisplayed])
  @@map("user_badges")
}

model LevelUpNotification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  newLevel    Int      @map("new_level")
  previousLevel Int    @map("previous_level")
  xpEarned    Int      @map("xp_earned")
  rewards     String?  @db.Text // JSON string containing rewards
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("level_up_notifications")
}

model PointsTransaction {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  amount          Int      // Số điểm (dương cho nhận điểm, âm cho tiêu điểm)
  type            String   @db.VarChar(50) // vocabulary_learn, vocabulary_review, practice_correct, practice_complete, test_complete, achievement_unlock, streak_bonus, etc.
  description     String?  @db.Text
  sourceType      String?  @db.VarChar(50) // vocabulary, practice, test, achievement, streak
  sourceId        Int?     // ID của nguồn (ví dụ: vocabularyId, achievementId)
  multiplier      Float?   @default(1.0) // Nhân điểm (streak bonus)
  baseAmount      Int?     // Số điểm gốc trước khi nhân
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("points_transactions")
}
